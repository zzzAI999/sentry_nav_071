<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <PipelineSequence name="NavigateTwoPointLeg">
          <RateController hz="3.0">
            <RecoveryNode number_of_retries="5" name="ComputePathRetry">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <Wait wait_duration="0.3"/>
            </RecoveryNode>
          </RateController>
          <FollowPath path="{path}" controller_id="FollowPath"
                      goal_checker_id="two_point_goal_checker"/>
        </PipelineSequence>
        <Delay delay_msec="1000">
          <AlwaysFailure/>
        </Delay>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
